# 복사해서 .env 로 쓰세요 (.env 는 Git에 올라가지 않습니다).
# 값은 DB 담당자에게 받거나, 내 PC MySQL 8에 직접 만든 DB·계정으로 채웁니다 (README 「로컬 DB 준비」).
# 테이블은 만들지 않습니다. 서버가 시작할 때 Flyway가 V1부터 적용합니다.
#
# 개발 DB (bootRun). 테스트(dbTest)·시연(chagok_demo)과 같은 DB를 쓰지 않습니다.
DB_URL=jdbc:mysql://localhost:3306/chagok?characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=chagok
DB_PASSWORD=change-me

# dbTest는 빈 테스트 전용 DB에서 돌립니다. 여기 값을 바꾸지 말고, 실행할 때만 OS 환경변수로 덮어씁니다 (README):
#   DB_URL='jdbc:mysql://localhost:3306/chagok_test?characterEncoding=UTF-8&serverTimezone=Asia/Seoul' ./gradlew dbTest
