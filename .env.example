# 복사해서 .env 로 쓰세요 (.env 는 Git에 올라가지 않습니다).
# 실제 DB 생성과 계정은 DB 담당자가 관리합니다. 값은 DB 담당자에게 받으세요.
DB_URL=jdbc:mysql://localhost:3306/chagok?characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=chagok
DB_PASSWORD=change-me

# JWT 서명 키 (HS256, 32바이트 이상). 각자 만들어 넣고 공유·커밋하지 않습니다. 비어 있으면 서버가 뜨지 않습니다.
#   Git Bash:  openssl rand -base64 48
JWT_SECRET=
